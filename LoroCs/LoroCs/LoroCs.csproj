<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <LangVersion>Latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.17.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- scripts/generate-bindings.ps1 writes Generated/loro.cs; the SDK compiles it with the other sources. -->
  <Target Name="RequireLoroBindings" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Generated/loro.cs')" Text="Generated/loro.cs is missing. Run scripts/generate-bindings.ps1 first." />
  </Target>

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>LoroCs</PackageId>
    <Version>0.1.0</Version>
    <Authors>Simon Ensslen;RenewedVision</Authors>
    <Description>LoroCs .NET bindings with the native loro library from Rust</Description>
    <IncludeSymbols>true</IncludeSymbols>
    <IncludeSource>true</IncludeSource>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/sensslen/loro-cs</RepositoryUrl>
    <PackageTags>Loro</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- CI stages each native library as artifacts/runtimes/<rid>/native/loro.* -->
  <ItemGroup>
    <None Include="..\..\artifacts\runtimes\**\*" Pack="true" PackagePath="runtimes" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\README.md">
      <Pack>true</Pack>
      <PackagePath>README.md</PackagePath>
    </Content>
  </ItemGroup>

</Project>
